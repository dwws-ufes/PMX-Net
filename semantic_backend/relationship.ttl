
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ex:   <http://example.org/relationship#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <http://schema.org/> .


foaf:knows owl:equivalentProperty schema:knows . # remover para testar se continua funcionando.

# Colabora regularmente
ex:collaboratesWith a rdf:Property ;
  rdfs:label "Colabora regularmente"@pt ;
  rdfs:comment "Indica colaboração regular (≥ 3 tarefas ou PRs em comum nos últimos 3 meses)."@pt ;
  rdfs:subPropertyOf foaf:knows ;
  owl:equivalentProperty schema:colleague .

# Colaboração intensa
ex:strongCollaboratorOf a rdf:Property ;
  rdfs:label "Colaboração intensa"@pt ;
  rdfs:comment "Indica colaboração intensa (≥ 10 tarefas/PRs em coautoria + revisões cruzadas)."@pt ;
  rdfs:subPropertyOf foaf:knows .
