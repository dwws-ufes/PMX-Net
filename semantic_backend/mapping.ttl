@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ex: <http://example.org/relationship#> .

<#ParticipanteMapping>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "participante" ] ;

  rr:subjectMap [
    rr:template "http://example.org/participante/{id}" ;
    rr:class foaf:Person ;
  ] ;

  rr:predicateObjectMap [
    rr:predicate foaf:name ;
    rr:objectMap [ rr:column "nome" ]
  ] .

<#KnowsMapping>
  a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "relaciona" ] ;

  rr:subjectMap [
    rr:template "http://example.org/participante/{conhece}" ;
  ] ;

  rr:predicateObjectMap [
    rr:predicate foaf:knows ;
    rr:objectMap [ rr:template "http://example.org/participante/{conhecido}" ]
  ] .

<#CollaboratesWithMapping>
  a rr:TriplesMap ;
  rr:logicalTable [
    rr:sqlQuery """
      SELECT
        t.conhece AS p1_id,
        t.conhecido AS p2_id,
        COUNT(*) AS interaction
      FROM relaciona t
      GROUP BY p1_id, p2_id
      HAVING COUNT(*) >= 3
    """
  ] ;

  rr:subjectMap [
    rr:template "http://example.org/participante/{p1_id}" ;
  ] ;

  rr:predicateObjectMap [
    rr:predicate ex:collaboratesWith ;
    rr:objectMap [ rr:template "http://example.org/participante/{p2_id}" ]
  ] .


<#StrongCollaboratorOfMapping>
  a rr:TriplesMap ;
  rr:logicalTable [
    rr:sqlQuery """
      SELECT
        t.conhece AS p1_id,
        t.conhecido AS p2_id,
        COUNT(*) AS interaction
      FROM relaciona t
      GROUP BY p1_id, p2_id
      HAVING COUNT(*) >= 10
    """
  ] ;

  rr:subjectMap [
    rr:template "http://example.org/participante/{p1_id}" ;
  ] ;

  rr:predicateObjectMap [
    rr:predicate ex:strongCollaboratorOf ;
    rr:objectMap [ rr:template "http://example.org/participante/{p2_id}" ]
  ] .
